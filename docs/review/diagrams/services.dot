digraph services {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.45", ranksep="1.0", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans", fontsize=11, fontcolor="#18333d"];
edge [fontname="DejaVu Sans", fontsize=10, color="#527476", fontcolor="#335e62", arrowsize=0.65, labeldistance=2.1];
peer [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Relay connection</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Process-local state</FONT></TD></TR><TR><TD ALIGN="LEFT">K: id: u64 (per process)</TD></TR><TR><TD ALIGN="LEFT">TCP / WebSocket</TD></TR><TR><TD ALIGN="LEFT">Sender&lt;String&gt; outbound queue</TD></TR></TABLE>>];
player [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Player</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Stats.players[id]</FONT></TD></TR><TR><TD ALIGN="LEFT">K: id (map key)</TD></TR><TR><TD ALIGN="LEFT">name, joined, last_seen</TD></TR><TR><TD ALIGN="LEFT">last_xy, rounded lat/lon</TD></TR><TR><TD ALIGN="LEFT">speed_kmh, boosting, updates, drops</TD></TR></TABLE>>];
event [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>JSONL event</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">RELAY_LOG / players.jsonl</FONT></TD></TR><TR><TD ALIGN="LEFT">no unique event key</TD></TR><TR><TD ALIGN="LEFT">t, kind, id, name, text</TD></TR><TR><TD ALIGN="LEFT">lat?, lon?, online</TD></TR><TR><TD ALIGN="LEFT">join | drop | flipped | leave</TD></TR></TABLE>>];
recent [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Event</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Stats.events (max 60)</FONT></TD></TR><TR><TD ALIGN="LEFT">at, kind, text</TD></TR><TR><TD ALIGN="LEFT">lat?, lon?</TD></TR><TR><TD ALIGN="LEFT">no retained id or name fields</TD></TR></TABLE>>];
remote [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Remote</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Other clients&#39; Remotes.trucks[id]</FONT></TD></TR><TR><TD ALIGN="LEFT">K: id (per client map)</TD></TR><TR><TD ALIGN="LEFT">name, albers, h, target_rot, vel</TD></TR><TR><TD ALIGN="LEFT">entity, beacon, label</TD></TR><TR><TD ALIGN="LEFT">seen, rate, jitter, smoothing_err</TD></TR></TABLE>>];
quota [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Lidar State</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Service singleton / memory</FONT></TD></TR><TR><TD ALIGN="LEFT">running: HashSet&lt;TileId&gt;</TD></TR><TR><TD ALIGN="LEFT">day: u64</TD></TR><TR><TD ALIGN="LEFT">calls_today: u32</TD></TR></TABLE>>];
lidarjob [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Lidar build request</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Worker / runtime</FONT></TD></TR><TR><TD ALIGN="LEFT">K: tile.tx + tile.ty</TD></TR><TR><TD ALIGN="LEFT">at most one running job</TD></TR><TR><TD ALIGN="LEFT">request → resample → fill → encode</TD></TR></TABLE>>];
cache [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Lidar cache entry</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">HIRES_CACHE / files</FONT></TD></TR><TR><TD ALIGN="LEFT">K: tx_ty (filename)</TD></TR><TR><TD ALIGN="LEFT">{tile}.vrh: successful patch</TD></TR><TR><TD ALIGN="LEFT">{tile}.none: no-lidar message</TD></TR><TR><TD ALIGN="LEFT">success checked before .none</TD></TR></TABLE>>];
peer -> player [label="tracks while connected", taillabel="1", headlabel="1", style=solid];
peer -> event [label="records historical events", taillabel="1", headlabel="0..*", style=dashed];
event -> recent [label="projects / loads tail", taillabel="1", headlabel="0..1", style=dashed];
peer -> remote [label="pose seen by other clients", taillabel="1", headlabel="0..*", style=solid];
quota -> lidarjob [label="admits running tile", taillabel="1", headlabel="0..1", style=solid];
lidarjob -> cache [label="produces outcome over time", taillabel="0..*", headlabel="0..1", style=dashed];
}
