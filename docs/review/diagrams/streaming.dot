digraph streaming {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.45", ranksep="1.0", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans", fontsize=11, fontcolor="#18333d"];
edge [fontname="DejaVu Sans", fontsize=10, color="#527476", fontcolor="#335e62", arrowsize=0.65, labeldistance=2.1];
terrain [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Terrain</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Bevy resource</FONT></TD></TR><TR><TD ALIGN="LEFT">grid, albers, source</TD></TR><TR><TD ALIGN="LEFT">jobs: Vec&lt;Job&gt;</TD></TR><TR><TD ALIGN="LEFT">built: HashMap&lt;Patch, Built&gt;</TD></TR><TR><TD ALIGN="LEFT">hires: HashMap&lt;TileId, HiresState&gt;</TD></TR></TABLE>>];
patch [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Patch</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Value key</FONT></TD></TR><TR><TD ALIGN="LEFT">K: Super(sx, sy)</TD></TR><TR><TD ALIGN="LEFT">or Tile(tx, ty, lod)</TD></TR><TR><TD ALIGN="LEFT">or Hires(tx, ty)</TD></TR></TABLE>>];
job [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Job</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Pending work</FONT></TD></TR><TR><TD ALIGN="LEFT">patch: Patch; prio: f64</TD></TR><TR><TD ALIGN="LEFT">stage: Fetch | Plan | Wait | Build</TD></TR><TR><TD ALIGN="LEFT">ll: Vec&lt;(lon, lat)&gt;</TD></TR><TR><TD ALIGN="LEFT">heights: Vec&lt;f32&gt;</TD></TR></TABLE>>];
built [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Built</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Terrain.built value</FONT></TD></TR><TR><TD ALIGN="LEFT">K: Patch (map key)</TD></TR><TR><TD ALIGN="LEFT">entity: Entity</TD></TR><TR><TD ALIGN="LEFT">heights: Arc&lt;Heights&gt;</TD></TR></TABLE>>];
heights [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Heights</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">CPU physics / picking</FONT></TD></TR><TR><TD ALIGN="LEFT">x_min, y_max, spacing: f64</TD></TR><TR><TD ALIGN="LEFT">n: usize</TD></TR><TR><TD ALIGN="LEFT">data: Vec&lt;f32&gt;</TD></TR></TABLE>>];
entity [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Terrain ECS entity</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Rendered patch</FONT></TD></TR><TR><TD ALIGN="LEFT">K: Entity</TD></TR><TR><TD ALIGN="LEFT">Mesh3d, material handle</TD></TR><TR><TD ALIGN="LEFT">Draped(Option&lt;MosaicKey&gt;)</TD></TR><TR><TD ALIGN="LEFT">Anchor, Transform, Visibility</TD></TR></TABLE>>];
mosaic [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Mosaic</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Imagery.mosaics entry</FONT></TD></TR><TR><TD ALIGN="LEFT">K: z, x0, y0, x1, y1</TD></TR><TR><TD ALIGN="LEFT">Waiting | Building | Ready</TD></TR><TR><TD ALIGN="LEFT">Ready → material → image</TD></TR></TABLE>>];
block [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>COG block</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Cog.tiles entry</FONT></TD></TR><TR><TD ALIGN="LEFT">K: cell + level + tx + ty</TD></TR><TR><TD ALIGN="LEFT">Queued | Pending | Ready | Failed</TD></TR><TR><TD ALIGN="LEFT">Ready: Arc&lt;TileData&gt;</TD></TR><TR><TD ALIGN="LEFT">w, h, data: Vec&lt;f32&gt;</TD></TR></TABLE>>];
cell [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>CellMeta / Level</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Cog.cells ready metadata</FONT></TD></TR><TR><TD ALIGN="LEFT">K: north + west</TD></TR><TR><TD ALIGN="LEFT">origin_lon, origin_lat, header</TD></TR><TR><TD ALIGN="LEFT">levels: dimensions + byte ranges</TD></TR></TABLE>>];
terrain -> job [label="owns queue", taillabel="1", headlabel="0..*", style=solid];
terrain -> built [label="owns built map", taillabel="1", headlabel="0..*", style=solid];
job -> patch [label="addresses", taillabel="0..1", headlabel="1", style=solid];
built -> patch [label="keyed by", taillabel="0..1", headlabel="1", style=solid];
built -> heights [label="retains", taillabel="1", headlabel="1", style=solid];
built -> entity [label="references", taillabel="1", headlabel="1", style=solid];
entity -> mosaic [label="requests detail key", taillabel="0..*", headlabel="0..1", style=solid];
job -> block [label="Wait keys (COG path)", taillabel="0..*", headlabel="0..*", style=solid];
cell -> block [label="defines byte ranges", taillabel="1", headlabel="0..*", style=solid];
}
