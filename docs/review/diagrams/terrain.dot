digraph terrain {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.45", ranksep="1.0", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans", fontsize=11, fontcolor="#18333d"];
edge [fontname="DejaVu Sans", fontsize=10, color="#527476", fontcolor="#335e62", arrowsize=0.65, labeldistance=2.1];
grid [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>GridSpec</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Embedded configuration</FONT></TD></TR><TR><TD ALIGN="LEFT">origin_x: f64</TD></TR><TR><TD ALIGN="LEFT">origin_y: f64</TD></TR><TR><TD ALIGN="LEFT">EPSG:5070; 3,750 m tiles</TD></TR></TABLE>>];
index [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>StoreIndex</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">store/index.json</FONT></TD></TR><TR><TD ALIGN="LEFT">grid: GridSpec</TD></TR><TR><TD ALIGN="LEFT">tiles: BTreeMap&lt;String, TileEntry&gt;</TD></TR></TABLE>>];
entry [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>TileEntry</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Embedded JSON entry</FONT></TD></TR><TR><TD ALIGN="LEFT">K: tx_ty (parent map key)</TD></TR><TR><TD ALIGN="LEFT">status: ok | empty | failed</TD></TR><TR><TD ALIGN="LEFT">error?: String</TD></TR><TR><TD ALIGN="LEFT">min/max_elevation_m?: f32</TD></TR><TR><TD ALIGN="LEFT">filled_samples: u32</TD></TR><TR><TD ALIGN="LEFT">sources: Vec&lt;String&gt;</TD></TR></TABLE>>];
source [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>SourceCell</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">cache/USGS_13_nNNwWWW.tif</FONT></TD></TR><TR><TD ALIGN="LEFT">K: north + west</TD></TR><TR><TD ALIGN="LEFT">name: nNNwWWW</TD></TR><TR><TD ALIGN="LEFT">optional .part / .missing markers</TD></TR></TABLE>>];
raster [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>Stored height raster</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">store/{tx}_{ty}.tif</FONT></TD></TR><TR><TD ALIGN="LEFT">K: tx + ty (filename)</TD></TR><TR><TD ALIGN="LEFT">376 × 376 f32 samples</TD></TR><TR><TD ALIGN="LEFT">10 m; point-registered</TD></TR><TR><TD ALIGN="LEFT">EPSG:5070 + georeference</TD></TR></TABLE>>];
meta [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>TileMetadata</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">tiles/{tx}_{ty}.json</FONT></TD></TR><TR><TD ALIGN="LEFT">K: tile.tx + tile.ty</TD></TR><TR><TD ALIGN="LEFT">bounds, grid_origin, crs</TD></TR><TR><TD ALIGN="LEFT">vertical_datum, sources, version</TD></TR><TR><TD ALIGN="LEFT">heights_file → tiles/{tile}.f32</TD></TR></TABLE>>];
lod [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>LodInfo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">Embedded metadata array</FONT></TD></TR><TR><TD ALIGN="LEFT">K: tile + lod</TD></TR><TR><TD ALIGN="LEFT">spacing_m, nodes_per_side</TD></TR><TR><TD ALIGN="LEFT">file → lod{0..3}/{tile}.glb</TD></TR><TR><TD ALIGN="LEFT">10 / 30 / 150 / 750 m</TD></TR></TABLE>>];
vrh [label=<<TABLE BORDER="1" COLOR="#b4c9c6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#ffffff"><TR><TD ALIGN="LEFT" BGCOLOR="#183b45"><FONT COLOR="#ffffff" POINT-SIZE="15"><B>PackedPatch</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6efed"><FONT COLOR="#325c60" POINT-SIZE="10">packed/t{0..4}/… or s/… .vrh</FONT></TD></TR><TR><TD ALIGN="LEFT">K: kind + level + grid address</TD></TR><TR><TD ALIGN="LEFT">VRH1, side, step, base, wide</TD></TR><TR><TD ALIGN="LEFT">Brotli residuals + border ring</TD></TR><TR><TD ALIGN="LEFT">identity is in the path</TD></TR></TABLE>>];
index -> grid [label="embeds", taillabel="1", headlabel="1", style=solid];
index -> entry [label="maps tile keys", taillabel="1", headlabel="0..*", style=solid];
entry -> source [label="records source names", taillabel="0..*", headlabel="0..*", style=solid];
entry -> raster [label="locates height file", taillabel="1", headlabel="0..1", style=solid];
entry -> meta [label="bake derives", taillabel="1", headlabel="0..1", style=dashed];
meta -> lod [label="embeds", taillabel="1", headlabel="4", style=solid];
raster -> vrh [label="pack samples + neighbours", taillabel="0..*", headlabel="0..*", style=dashed];
}
